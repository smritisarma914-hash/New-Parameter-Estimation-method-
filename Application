## -----------------------------------------------------------------------
## 3. Estimation: apply every method to each series, with bootstrap SEs
## -----------------------------------------------------------------------

K_list <- c(3, 5, 8)     # single definition, used consistently throughout
B_boot <- 500
cf_n_starts <- 9

analyze_series <- function(prices, name, seed = 1) {
  z <- log_return(prices)
  n <- length(z)
  theta <- z %% (2 * pi)          # TRUE modular wrapping (not to_angle())

  point <- list()
  point$K2_existing <- truncate_alpha(alpha_WS2(theta))
  for (K in K_list) {
    point[[paste0("OLS_K", K)]] <- truncate_alpha(alpha_WS_K(theta, K))
    point[[paste0("GLS_K", K)]] <- truncate_alpha(alpha_WS_K_GLS(theta, K))
  }
  ad <- alpha_adaptive(theta)
  point$adaptive   <- ad$alpha_hat
  point$adaptive_K <- ad$K_used
  cf <- alpha_CF(z, n_starts = cf_n_starts)
  point$CF <- cf$alpha
  point$CF_sigma <- cf$sigma
  point$CF_boundary_pinned <- cf$boundary_pinned

  rho_hat <- Rbar_p(theta, 1)
  mu_hat  <- atan2(Sbar_p(theta, 1), Cbar_p(theta, 1))
  frac_beyond_pi <- mean(abs(z) > pi)

  set.seed(seed)
  boot_names <- c("K2_existing", paste0("OLS_K", K_list),
                   paste0("GLS_K", K_list), "adaptive", "CF")
  boot <- matrix(NA_real_, B_boot, length(boot_names))
  colnames(boot) <- boot_names
  for (b in 1:B_boot) {
    idx <- sample.int(n, n, replace = TRUE)
    zb <- z[idx]
    thb <- zb %% (2 * pi)
    boot[b, "K2_existing"] <- truncate_alpha(alpha_WS2(thb))
    for (K in K_list) {
      boot[b, paste0("OLS_K", K)] <- truncate_alpha(alpha_WS_K(thb, K))
      boot[b, paste0("GLS_K", K)] <- truncate_alpha(alpha_WS_K_GLS(thb, K))
    }
    boot[b, "adaptive"] <- alpha_adaptive(thb)$alpha_hat
    boot[b, "CF"] <- alpha_CF(zb, n_starts = 5)$alpha
  }
  se <- apply(boot, 2, sd)

  list(name = name, n = n, rho_hat = rho_hat, mu_hat = mu_hat,
       frac_beyond_pi = frac_beyond_pi, point = point, se = se)
}

results <- lapply(names(price_series), function(nm) analyze_series(price_series[[nm]], nm))
names(results) <- names(price_series)

for (r in results) {
  cat(sprintf("\n=== %s (n = %d returns) ===  rho_hat = %.3f   frac(|z|>pi) = %.2f\n",
              r$name, r$n, r$rho_hat, r$frac_beyond_pi))
  for (k in c("K2_existing", paste0("OLS_K", K_list), paste0("GLS_K", K_list), "adaptive")) {
    cat(sprintf("  %-14s = %8.4f   bootstrap SE = %.4f\n", k, r$point[[k]], r$se[[k]]))
  }
  flag <- if (isTRUE(r$point$CF_boundary_pinned)) "  [BOUNDARY-PINNED: treat with caution]" else ""
  cat(sprintf("  %-14s = %8.4f   bootstrap SE = %.4f%s\n", "CF", r$point$CF, r$se[["CF"]], flag))
}

row_from_result <- function(r) {
  base <- data.frame(series = r$name, n = r$n, rho_hat = r$rho_hat,
                      mu_hat = r$mu_hat, frac_beyond_pi = r$frac_beyond_pi)
  pts <- as.data.frame(r$point[setdiff(names(r$point),
                                        c("adaptive_K", "CF_sigma", "CF_boundary_pinned"))])
  names(pts) <- paste0("est_", names(pts))
  ses <- as.data.frame(as.list(r$se))
  names(ses) <- paste0("se_", names(ses))
  cbind(base, adaptive_K = r$point$adaptive_K,
        CF_sigma = r$point$CF_sigma,
        CF_boundary_pinned = r$point$CF_boundary_pinned,
        pts, ses)
}

