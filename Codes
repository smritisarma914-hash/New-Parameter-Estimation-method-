## -----------------------------------------------------------------------

Cbar_p <- function(theta, p) mean(cos(p * theta))
Sbar_p <- function(theta, p) mean(sin(p * theta))
Rbar_p <- function(theta, p) sqrt(Cbar_p(theta, p)^2 + Sbar_p(theta, p)^2)

alpha_WS2 <- function(theta) {
  R1 <- Rbar_p(theta, 1); R2 <- Rbar_p(theta, 2)
  log(log(R2) / log(R1)) / log(2)
}

alpha_WS_K <- function(theta, K) {
  p_seq <- 1:K
  Rp <- vapply(p_seq, function(p) Rbar_p(theta, p), numeric(1))
  y <- log(-log(Rp)); x <- log(p_seq)
  xm <- mean(x); ym <- mean(y)
  sum((x - xm) * (y - ym)) / sum((x - xm)^2)
}

