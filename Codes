## -----------------------------------------------------------------------
## 4. Risk analysis: VaR / Expected Shortfall from the fitted stable model
## -----------------------------------------------------------------------
##


sigma_hat_from_returns <- function(r, alpha, K = 5) {
  z  <- r - median(r)
  s  <- sd(z)                       # just an anchor to choose a sensible t-grid
  t0 <- 1 / s
  t_seq <- (1:K) * t0
  Cb <- vapply(t_seq, function(t) mean(cos(t * z)), numeric(1))
  Sb <- vapply(t_seq, function(t) mean(sin(t * z)), numeric(1))
  Rb <- pmin(pmax(sqrt(Cb^2 + Sb^2), 1e-8), 1 - 1e-8)
  y  <- log(-log(Rb)); x <- log(t_seq)
  log_sigma <- mean(y - alpha * x) / alpha
  exp(log_sigma)
}

## Prefer the `stabledist` package for exact quantiles (qstable) and a
## direct numerical Expected-Shortfall integral; fall back to a large
## Monte-Carlo simulation (via rstable_sym) if it isn't installed.
have_stabledist <- requireNamespace("stabledist", quietly = TRUE)

VaR_ES_stable <- function(alpha, sigma, mu, p) {
  if (have_stabledist) {
    q <- stabledist::qstable(p, alpha = alpha, beta = 0, gamma = sigma, delta = mu, pm = 1)
    VaR <- -q
    us  <- seq(p / 200, p, length.out = 200)
    qs  <- stabledist::qstable(us, alpha = alpha, beta = 0, gamma = sigma, delta = mu, pm = 1)
    ES  <- -mean(qs)
  } else {
    N <- 200000
    X <- mu + sigma * rstable_sym(N, alpha)
    q <- quantile(X, p)
    VaR <- -as.numeric(q)
    ES  <- -mean(X[X <= q])
  }
  c(VaR = VaR, ES = ES)
}

risk_table <- data.frame()
for (nm in names(returns_list)) {
  r <- returns_list[[nm]]
  alpha_hat <- min(max(alpha_table$adaptive[alpha_table$series == nm], 0.05), 1.99)
  mu_hat    <- median(r)
  sigma_hat <- sigma_hat_from_returns(r, alpha_hat, K = min(5, length(r) - 1))

  s95 <- VaR_ES_stable(alpha_hat, sigma_hat, mu_hat, 0.05)
  s99 <- VaR_ES_stable(alpha_hat, sigma_hat, mu_hat, 0.01)

  ## Normal benchmark fitted to the same raw returns
  mu_n <- mean(r); sd_n <- sd(r)
  z95 <- qnorm(0.05); z99 <- qnorm(0.01)
  VaR95_n <- -(mu_n + z95 * sd_n)
  VaR99_n <- -(mu_n + z99 * sd_n)
  ES95_n  <- -(mu_n - sd_n * dnorm(z95) / 0.05)
  ES99_n  <- -(mu_n - sd_n * dnorm(z99) / 0.01)

  risk_table <- rbind(risk_table, data.frame(
    series = nm, alpha_hat = round(alpha_hat, 3), sigma_hat = round(sigma_hat, 5),
    VaR95_stable = round(100 * s95["VaR"], 3), VaR95_normal = round(100 * VaR95_n, 3),
    VaR99_stable = round(100 * s99["VaR"], 3), VaR99_normal = round(100 * VaR99_n, 3),
    ES95_stable  = round(100 * s95["ES"], 3),  ES95_normal  = round(100 * ES95_n, 3),
    ES99_stable  = round(100 * s99["ES"], 3),  ES99_normal  = round(100 * ES99_n, 3)
  ))
}

