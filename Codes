## =============================================================================
## Multi-point trigonometric-moment regression estimator of alpha
## for the wrapped stable distribution

## -----------------------------------------------------------------------
## 1. Random generation
## -----------------------------------------------------------------------

## Chambers-Mallows-Stuck generator for a standard symmetric alpha-stable
## variable X with characteristic function exp(-|t|^alpha) (i.e. sigma = 1,
## mu = 0, beta = 0).
rstable_sym <- function(n, alpha) {
  U <- runif(n, -pi / 2, pi / 2)
  W <- rexp(n, rate = 1)
  if (abs(alpha - 1) < 1e-8) {
    return(tan(U))  # symmetric Cauchy
  }
  term1 <- sin(alpha * U) / (cos(U))^(1 / alpha)
  term2 <- (cos(U - alpha * U) / W)^((1 - alpha) / alpha)
  term1 * term2
}

rwrapped_stable <- function(m, alpha, rho, mu = 0) {
  sigma <- (-log(rho))^(1 / alpha)
  X <- rstable_sym(m, alpha)
  (mu + sigma * X) %% (2 * pi)
}

## -----------------------------------------------------------------------
## 2. Empirical trigonometric moments
## -----------------------------------------------------------------------

Cbar_p <- function(theta, p) mean(cos(p * theta))
Sbar_p <- function(theta, p) mean(sin(p * theta))
Rbar_p <- function(theta, p) sqrt(Cbar_p(theta, p)^2 + Sbar_p(theta, p)^2)

## -----------------------------------------------------------------------
## 3. Existing two-point estimator (SenGupta 1996; SenGupta & Roy 2019, 2023)
## -----------------------------------------------------------------------

alpha_WS2 <- function(theta) {
  R1 <- Rbar_p(theta, 1)
  R2 <- Rbar_p(theta, 2)
  log(log(R2) / log(R1)) / log(2)
}

## -----------------------------------------------------------------------
## 4. Proposed K-point regression estimator (OLS)
## -----------------------------------------------------------------------

## Returns the OLS slope of y_p = ln(-ln Rbar_p) on x_p = ln p, p = 1..K.
## K = 2 reproduces alpha_WS2() exactly.
alpha_WS_K <- function(theta, K) {
  p_seq <- 1:K
  Rp <- vapply(p_seq, function(p) Rbar_p(theta, p), numeric(1))
  y <- log(-log(Rp))
  x <- log(p_seq)
  xm <- mean(x); ym <- mean(y)
  sum((x - xm) * (y - ym)) / sum((x - xm)^2)
}

## Truncation to the admissible range (0, 2], matching the existing
## literature's truncated trigonometric moment (ttm) device: only the
## upper boundary is truncated (estimates >= 2 are set to 2).
truncate_alpha <- function(a) if (a >= 2) 2 else a

## -----------------------------------------------------------------------
## 5. Theoretical asymptotic covariance Sigma_K and Jacobian J
## -----------------------------------------------------------------------

## rho_j = rho^(|j|^alpha), with the convention rho_0 = 1.
rho_j <- function(j, alpha, rho) rho^(abs(j)^alpha)

## Population 2K-vector xi = E[(cos theta, sin theta, ..., cos K theta,
## sin K theta)].
xi_vec <- function(alpha, rho, mu, K) {
  out <- numeric(2 * K)
  for (p in 1:K) {
    out[2 * p - 1] <- rho_j(p, alpha, rho) * cos(p * mu)
    out[2 * p]     <- rho_j(p, alpha, rho) * sin(p * mu)
  }
  out
}


build_SigmaK <- function(alpha, rho, mu, K) {
  Sigma <- matrix(0, 2 * K, 2 * K)
  xiC <- function(p) rho_j(p, alpha, rho) * cos(p * mu)
  xiS <- function(p) rho_j(p, alpha, rho) * sin(p * mu)
  CC <- function(p, q) 0.5 * (rho_j(p - q, alpha, rho) * cos((p - q) * mu) +
                                rho_j(p + q, alpha, rho) * cos((p + q) * mu)) -
                          xiC(p) * xiC(q)
  SS <- function(p, q) 0.5 * (rho_j(p - q, alpha, rho) * cos((p - q) * mu) -
                                rho_j(p + q, alpha, rho) * cos((p + q) * mu)) -
                          xiS(p) * xiS(q)
  CS <- function(p, q) 0.5 * (rho_j(p + q, alpha, rho) * sin((p + q) * mu) -
                                rho_j(p - q, alpha, rho) * sin((p - q) * mu)) -
                          xiC(p) * xiS(q)
  for (p in 1:K) for (q in 1:K) {
    Sigma[2 * p - 1, 2 * q - 1] <- CC(p, q)
    Sigma[2 * p,     2 * q]     <- SS(p, q)
    Sigma[2 * p - 1, 2 * q]     <- CS(p, q)
    Sigma[2 * q,     2 * p - 1] <- CS(p, q)  # symmetry: Cov(S_q,C_p)=Cov(C_p,S_q)
  }
  Sigma
}

## K x 2K Jacobian of y_p = ln(-ln Rbar_p) at the population point,
## block-diagonal with 1x2 blocks (-cos(p*mu)/(rho_p*ln rho_p),
## -sin(p*mu)/(rho_p*ln rho_p)).
build_J <- function(alpha, rho, mu, K) {
  J <- matrix(0, K, 2 * K)
  for (p in 1:K) {
    rp <- rho_j(p, alpha, rho)
    g <- -1 / (rp * log(rp))
    J[p, 2 * p - 1] <- g * cos(p * mu)
    J[p, 2 * p]     <- g * sin(p * mu)
  }
  J
}

## OLS weight vector a (K x 1) such that alpha_hat_K = a' * y.
ols_weights <- function(K) {
  x <- log(1:K)
  xm <- mean(x)
  (x - xm) / sum((x - xm)^2)
}

## Asymptotic variance of sqrt(m)*(alpha_hat_K - alpha) under the OLS
## regression estimator, i.e. a' J Sigma_K J' a.
asymptotic_var_OLS <- function(alpha, rho, mu, K) {
  Sigma <- build_SigmaK(alpha, rho, mu, K)
  J <- build_J(alpha, rho, mu, K)
  a <- ols_weights(K)
  as.numeric(t(a) %*% J %*% Sigma %*% t(J) %*% a)
}

## -----------------------------------------------------------------------
## 6. GLS refinement (plug-in, two-stage)
## -----------------------------------------------------------------------

alpha_WS_K_GLS <- function(theta, K) {
  m <- length(theta)
  a0 <- truncate_alpha(alpha_WS_K(theta, min(K, 2)))
  a0 <- min(max(a0, 0.05), 2)
  rho0 <- min(max(Rbar_p(theta, 1), 1e-6), 0.999)
  mu0 <- atan2(Sbar_p(theta, 1), Cbar_p(theta, 1))

  Sigma <- build_SigmaK(a0, rho0, mu0, K)
  J <- build_J(a0, rho0, mu0, K)
  W <- (J %*% Sigma %*% t(J)) / m           # Var(y-hat) at sample size m
  W <- W + diag(1e-10, K)                    # ridge for numerical stability

  p_seq <- 1:K
  Rp <- vapply(p_seq, function(p) Rbar_p(theta, p), numeric(1))
  y <- log(-log(Rp))
  X <- cbind(1, log(p_seq))

  Winv <- solve(W)
  beta_gls <- solve(t(X) %*% Winv %*% X) %*% t(X) %*% Winv %*% y
  as.numeric(beta_gls[2])
}

## -----------------------------------------------------------------------
## 7. Signal-to-noise rule for choosing K, and the adaptive estimator
## -----------------------------------------------------------------------

Kstar <- function(alpha, rho, m, c0 = 2, Kmin = 2, Kmax = 15) {
  if (rho <= 0 || rho >= 1 || alpha <= 0) return(Kmin)
  val <- log(c0 / sqrt(2 * m)) / log(rho)
  if (val <= 0) return(Kmin)
  K <- val^(1 / alpha)
  as.integer(min(max(round(K), Kmin), Kmax))
}


alpha_adaptive <- function(theta, c0 = 2, Kmin = 2, Kmax = 15) {
  m <- length(theta)
  a_pilot <- truncate_alpha(alpha_WS2(theta))
  a_pilot <- min(max(a_pilot, 0.05), 2)
  rho_pilot <- min(max(Rbar_p(theta, 1), 1e-6), 0.999)
  Khat <- Kstar(a_pilot, rho_pilot, m, c0 = c0, Kmin = Kmin, Kmax = Kmax)
  list(alpha_hat = truncate_alpha(alpha_WS_K(theta, Khat)), K_used = Khat)
}

## -----------------------------------------------------------------------
## 8. Simulation driver: bias / RMSE comparison
## -----------------------------------------------------------------------

simulate_config <- function(alpha_true, rho_true, m, K_list,
                             nrep = 1000, seed = NULL) {
  if (!is.null(seed)) set.seed(seed)

  methods <- c("K2_existing", paste0("K", K_list), "adaptive")
  store <- matrix(NA_real_, nrow = nrep, ncol = length(methods))
  colnames(store) <- methods
  Khat_used <- numeric(nrep)

  for (r in 1:nrep) {
    theta <- rwrapped_stable(m, alpha_true, rho_true, mu = 0)

    store[r, "K2_existing"] <- truncate_alpha(alpha_WS2(theta))
    for (K in K_list) {
      store[r, paste0("K", K)] <- truncate_alpha(alpha_WS_K(theta, K))
    }
    ad <- alpha_adaptive(theta)
    store[r, "adaptive"] <- ad$alpha_hat
    Khat_used[r] <- ad$K_used
  }

  bias <- colMeans(store) - alpha_true
  rmse <- sqrt(colMeans((store - alpha_true)^2))

  data.frame(
    method    = methods,
    alpha     = alpha_true,
    rho       = rho_true,
    m         = m,
    mean_bias = round(bias, 4),
    RMSE      = round(rmse, 4),
    row.names = NULL
  )
}

## -----------------------------------------------------------------------
## 9. Example: reproduce the comparison grid of Section 6
## -----------------------------------------------------------------------

grid <- expand.grid(
alpha_true = c(0.8, 1.3, 1.8),
rho_true   = c(0.6, 0.9),
m          = c(30, 50, 80, 100)
)

results <- do.call(rbind, lapply(seq_len(nrow(grid)), function(i) {
g <- grid[i, ]
simulate_config(g$alpha_true, g$rho_true, g$m,
                    K_list = c(3, 5, 8), nrep = 1000, seed = 100 + i)
 }))

 write.csv(results, "simulation_results.csv", row.names = FALSE)
 print(results)





